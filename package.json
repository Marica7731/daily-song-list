{
  "name": "daily-song-list",
  "version": "1.0.0",
  "private": true,
  "description": "Hourly YouTube timestamp song-list snapshots for 7-day and cumulative views.",
  "scripts": {
    "update": "npm run update:core && npm run review:build",
    "update:core": "node scripts/update-songlist.js && node scripts/apply-song-search-niche.js && node scripts/build-runtime-data.js && npm run validate:core",
    "review:build": "node scripts/build-review-queue.js && node scripts/export-dirty-candidates.js && npm run validate:review",
    "rebuild:video-catalog": "node scripts/rebuild-video-catalog.js",
    "rebuild:derived": "node scripts/rebuild-derived-data.js && node scripts/build-review-queue.js && node scripts/export-dirty-candidates.js && node scripts/build-runtime-data.js",
    "migrate:ranges-v2": "node scripts/migrate-permanent-data.js --dry-run",
    "migrate:catalog-unbounded": "node scripts/migrate-permanent-data.js",
    "import:git-history": "node scripts/migrate-permanent-data.js --dry-run",
    "backfill:history": "node scripts/migrate-permanent-data.js",
    "build:runtime": "node scripts/build-runtime-data.js",
    "version:assets": "node scripts/update-asset-version.js",
    "blocklist:generate": "node scripts/generate-blocked-vtuber-channels.js",
    "blocklist:validate": "node scripts/validate-blocked-vtuber-channels.js",
    "blocklist:check-sync": "node scripts/check-blocked-vtuber-sync.js",
    "compare:runtime-ranks": "node scripts/compare-runtime-ranks.js",
    "refresh:song-search": "node scripts/refresh-song-search-index.js",
    "diagnose:video": "node scripts/diagnose-video.js",
    "diagnose:song-dedup": "node scripts/diagnose-song-dedup.js",
    "diagnose:song-identities": "node scripts/diagnose-song-identities.js",
    "migrate:song-identities": "node scripts/diagnose-song-identities.js",
    "vsinger:discover-schema": "node scripts/vsinger-moment/discover-schema.js --dry-run",
    "vsinger:import-song-catalog": "node scripts/vsinger-moment/import-song-catalog.js --dry-run",
    "external:build-song-aliases": "node scripts/build-external-song-aliases.js",
    "external:build-video-candidates": "node scripts/build-external-video-candidates.js",
    "explain:diff": "node scripts/explain-diff.js",
    "mark:failure": "node scripts/mark-failure.js",
    "health:update": "node scripts/analyze-update-health.js",
    "watchdog:update": "node scripts/watchdog-update.js",
    "backfill:inbox": "node scripts/run-backfill-update.js",
    "validate": "node scripts/validate-data.js",
    "validate:core": "node scripts/validate-data.js --core",
    "validate:review": "node scripts/validate-data.js --review",
    "check:published": "node scripts/check-published-runtime.js",
    "verify:local": "node scripts/verify-local-performance.js",
    "screenshots:readme": "node scripts/capture-readme-screenshots.js",
    "check:ui-proof": "node scripts/validate-ui-proof.js",
    "check:budget": "node scripts/check-runtime-budgets.js",
    "check": "node scripts/check-js-syntax.js && npm run check:ui-proof && npm run blocklist:validate && npm test && npm run validate && npm run check:budget",
    "serve": "python -m http.server 8080",
    "test:scale": "node --test test/data-architecture.test.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
